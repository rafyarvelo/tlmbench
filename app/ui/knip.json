{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "browser.html",
    "viewer.html",
    "vite*.config.ts",
    "tests/*.{js,mjs}",
    "tests/parity/*.{js,mjs}",
    "src/browser-worker.ts",
