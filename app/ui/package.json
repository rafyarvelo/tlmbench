{
  "name": "tlmbench-ui",
  "private": true,
  "description": "TelemetryBench web UI: Svelte components around a WebGL2 renderer over the core's binary view batches",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
