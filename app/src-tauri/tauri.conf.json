{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TelemetryBench",
  "version": "0.1.0",
  "identifier": "dev.tlmbench.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TelemetryBench",
        "width": 1200,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
